{
  "name": "ace-public-pretotype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run check:facility && npm run check:landing && npm run check:design",
    "check:facility": "esbuild facility/check-scene.ts --bundle --platform=node --format=esm --outfile=/tmp/ace-check-facility.mjs && node /tmp/ace-check-facility.mjs",
    "check:landing": "esbuild landing/check-copy.ts --bundle --platform=node --format=esm --outfile=/tmp/ace-check-landing.mjs && node /tmp/ace-check-landing.mjs",
    "check:design": "esbuild landing/check-design.ts --bundle --platform=node --format=esm --outfile=/tmp/ace-check-design.mjs && node /tmp/ace-check-design.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@pascal-app/core": "1.0.0",
    "@pascal-app/nodes": "1.0.0",
    "@pascal-app/viewer": "1.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "lucide-react": "^0.554.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "three": "0.186.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.9",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "ws": "^8.18.3"
  }
}
